#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ATHENA_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

ENV_FILE="${ATHENA_DIR}/.env"
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

PROFILE="${HW_PROFILE:-low-vram-6gb}"
PROFILE_FILE="${ATHENA_DIR}/hardware-profiles/${PROFILE}.conf"

if [[ ! -f "$PROFILE_FILE" ]]; then
  echo "Error: Hardware profile '$PROFILE' not found at $PROFILE_FILE" >&2
  exit 1
fi
source "$PROFILE_FILE"

MODEL_PATH="${1:-${DEFAULT_GGUF_MODEL:-}}"
if [[ -z "$MODEL_PATH" || ! -f "$MODEL_PATH" ]]; then
  echo "Error: Valid GGUF model not found at: '$MODEL_PATH'" >&2
  echo "Usage: llama-launch [/path/to/model.gguf] (or set DEFAULT_GGUF_MODEL in Athena/.env)" >&2
  exit 1
fi

read -r -a FLAGS_ARRAY <<< "${EXTRA_FLAGS:-}"

echo "🏛️  Athena Engine Starting [Profile: $PROFILE | Context: $CTX_SIZE | KV: $KV_TYPE_K/$KV_TYPE_V]"
exec llama-server \
  -m "$MODEL_PATH" \
  -ngl "$NGL" \
  -c "$CTX_SIZE" \
  -t "$THREADS" \
  --cache-type-k "$KV_TYPE_K" \
  --cache-type-v "$KV_TYPE_V" \
  "${FLAGS_ARRAY[@]}" \
  --port "${LLAMA_PORT:-8080}" "${@:2}"

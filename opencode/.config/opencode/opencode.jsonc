{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_ACTIVE_MODEL}",
  "provider": {
    "local": {
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-athena-local"
      },
      "models": {
        "coder-local": {
          "name": "Athena Local Qwen (llama-server)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    },
    "zhipu": {
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "{env:ZHIPU_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash (Cloud MLA+DSA)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "instructions": [
    "~/.config/opencode/SYSTEM.md",
    "AGENTS.md",
    ".opencode/skills/*/SKILL.md"
  ]
}
